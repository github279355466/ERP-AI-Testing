{
  "environment": {
    "name": "athena-test",
    "type": "test",
    "baseUrl": "https://athena-test.digiwincloud.com.cn/",
    "tenantId": "digichannel",
    "applicationCode": "smbcloud",
    "lowcodeHost": "lowcode-form-render-test.apps.digiwincloud.com.cn",
    "allowedOrigins": [
      "https://athena-test.digiwincloud.com.cn/",
      "https://lowcode-form-render-test.apps.digiwincloud.com.cn"
    ],
    "blockedOrigins": []
