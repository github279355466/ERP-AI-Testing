  "paths": {
    "knowledge": "knowledge",
    "artifacts": "artifacts",
    "logs": "logs",
    "prd": "C:/Users/Administrator/AppData/Roaming/ade-client/ade-workspace/tenant_digichannel/solution_smbcloud/_prd_workspace/prd"
  },
  "safety": {
    "readOnly": true,
    "allowWrite": false,
    "allowHighRiskActions": false,
    "allowDelete": false,
    "allowAudit": false,
    "allowUnAudit": false,
    "allowPosting": false,
    "allowStatusChange": false,
