    "captureTrace": true,
    "localOnly": true,
    "retentionDays": 14,
    "redactSecrets": true
  },
  "knowledge": {
    "expectedModelVersion": "KM-380242c08313e3c2",
    "frozenModelPath": "artifacts/knowledge"
  },
  "run": {
    "operator": "",
