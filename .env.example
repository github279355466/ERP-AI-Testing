# 复制为 .env 后填写。禁止提交真实 .env。
# 本文件只列键名，不包含任何真实账号、口令、Cookie 或 Token。

ALLOW_ERP_UI_TEST=false
ERP_ENVIRONMENT_TYPE=test
ERP_ENVIRONMENT_NAME=athena-test
ERP_BASE_URL=https://athena-test.digiwincloud.com.cn/
ERP_OPERATOR=

# 登录凭据只从本机 .env 或运行环境读取，不写入代码、配置、日志或报告。
ERP_USERNAME=
ERP_PASSWORD=

# 高风险操作默认关闭。仅在明确授权的测试用例中逐项开启。
ALLOW_HIGH_RISK_ACTIONS=false
ALLOW_DELETE=false
ALLOW_AUDIT=false
ALLOW_UNAUDIT=false
ALLOW_POSTING=false
ALLOW_STATUS_CHANGE=false

# 可选覆盖
ATHENA_CONFIG=config/athena.config.json
ATHENA_CDP_ENDPOINT=http://127.0.0.1:9333
ATHENA_PROXY=http://127.0.0.1:10808
ATHENA_BROWSER_MODE=cdp
ATHENA_STORAGE_STATE=
ATHENA_USER_DATA_DIR=probe/chrome-profile
ATHENA_EXPECTED_MODEL_VERSION=
ATHENA_EVIDENCE_RETENTION_DAYS=14
