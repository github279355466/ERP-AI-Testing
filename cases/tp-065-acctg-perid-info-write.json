{
  "id": "TP-065-WRITE",
  "name": "会计期间信息：开窗、筛选、生成、保存、编辑、删除与清理（写入）",
  "workItem": "会计期间信息",
  "steps": [
    { "action": "log", "name": "阶段1：开窗结构与筛选" },
    { "action": "new" },
    { "action": "openLookup", "fieldPath": "acctg_perid_info.acctg_perid_table_no" },
    { "action": "assertLookup", "level": "ui", "name": "开窗结构", "titleContains": "查询会计期间表", "columns": ["会计期间表编号", "会计期间表名称", "分期数"], "minRows": 1, "single": true },
    { "action": "lookupFilter", "field": "会计期间表编号", "value": "T064-13-{{run}}" },
    { "action": "assertLookupRows", "level": "business", "name": "开窗筛选命中1条", "expected": 1 },
    { "action": "screenshot", "name": "TP-065-lookup-filtered" },
    { "action": "cancelLookup" },
    { "action": "assertFieldValue", "level": "ui", "name": "取消开窗不回填分期数", "fieldPath": "acctg_perid_info.insta_count", "expected": "" },

    { "action": "log", "name": "阶段2：选择会计期间表并填年度/日期" },
    { "action": "openLookup", "fieldPath": "acctg_perid_info.acctg_perid_table_no" },
    { "action": "lookupFilter", "field": "会计期间表编号", "value": "T064-13-{{run}}" },
    { "action": "selectLookupRow", "value": "T064-13-{{run}}", "column": "acctg_perid_table_no" },
    { "action": "confirmLookup" },
    { "action": "assertFieldValue", "level": "business", "name": "会计期间表编号回填", "fieldPath": "acctg_perid_info.acctg_perid_table_no", "expected": "T064-13-{{run}}", "mode": "contains" },
    { "action": "assertFieldValue", "level": "business", "name": "分期数回填", "fieldPath": "acctg_perid_info.insta_count", "expected": "13" },
    { "action": "fill", "fieldPath": "acctg_perid_info.acctg_year", "value": "2027" },
    { "action": "pickDate", "fieldPath": "acctg_perid_info.begin_date", "value": "2027-01-01" },
    { "action": "assertGridRows", "level": "business", "name": "日期变更本身不生成明细", "expected": 0 },
    { "action": "screenshot", "name": "TP-065-date-no-generate" },

    { "action": "log", "name": "阶段3：点击新增单身明细触发明细生成" },
    { "action": "clickButton", "text": "新增单身明细" },
    { "action": "assertToast", "level": "business", "name": "明细生成提示", "expected": "已生成 13 期明细" },
    { "action": "assertGridRows", "level": "business", "name": "生成13期明细", "expected": 13 },
    { "action": "assertGridCell", "level": "business", "name": "第1期开始日期", "rowIndex": 0, "colId": "begin_date", "expected": "2027-01-01" },
    { "action": "assertGridCell", "level": "business", "name": "第1期结束日期", "rowIndex": 0, "colId": "end_date", "expected": "2027-01-31" },
    { "action": "assertGridCell", "level": "business", "name": "第12期开始日期", "rowIndex": 11, "colId": "begin_date", "expected": "2027-12-01" },
    { "action": "assertGridCell", "level": "business", "name": "调整期开始日期", "rowIndex": 12, "colId": "begin_date", "expected": "2027-12-31" },
    { "action": "assertGridCell", "level": "business", "name": "调整期结束日期", "rowIndex": 12, "colId": "end_date", "expected": "2027-12-31" },
    { "action": "assertGridSwitch", "level": "business", "name": "第13期为调整期", "rowIndex": 12, "expected": true },
    { "action": "assertGridSwitch", "level": "business", "name": "第12期非调整期", "rowIndex": 11, "expected": false },
    { "action": "screenshot", "name": "TP-065-generated" },
    { "action": "fill", "fieldPath": "acctg_perid_info.rmk", "value": "自动化065-{{run}}" },
    { "action": "save" },
    { "action": "assertToast", "level": "business", "name": "保存提示", "expected": "操作成功" },
    { "action": "screenshot", "name": "TP-065-saved" },
    { "action": "closeDetail" },
    { "action": "waitRows", "min": 1 },
    { "action": "filter", "field": "会计期间表编号", "value": "T064-13-{{run}}" },
    { "action": "assertGridRows", "level": "business", "name": "列表筛选命中1条", "expected": 1 },
    { "action": "assertRowCell", "level": "persistence", "name": "会计年度回读", "matchColumn": "acctg_perid_table_no", "matchValue": "T064-13-{{run}}", "column": "acctg_year", "expected": "2027" },
    { "action": "assertRowCell", "level": "persistence", "name": "开始日期回读", "matchColumn": "acctg_perid_table_no", "matchValue": "T064-13-{{run}}", "column": "begin_date", "expected": "2027-01-01" },
    { "action": "screenshot", "name": "TP-065-list" },
    { "action": "clearFilter" },

    { "action": "log", "name": "阶段4：编辑备注" },
    { "action": "filter", "field": "会计期间表编号", "value": "T064-13-{{run}}" },
    { "action": "rowAction", "column": "acctg_perid_table_no", "value": "T064-13-{{run}}", "text": "编辑" },
    { "action": "assertFieldValue", "level": "business", "name": "编辑态会计年度", "fieldPath": "acctg_perid_info.acctg_year", "expected": "2027" },
    { "action": "fill", "fieldPath": "acctg_perid_info.rmk", "value": "已编辑065-{{run}}" },
    { "action": "save" },
    { "action": "assertToast", "level": "business", "name": "编辑保存提示", "expected": "操作成功" },
    { "action": "screenshot", "name": "TP-065-edited" },
    { "action": "closeDetail" },
    { "action": "filter", "field": "会计期间表编号", "value": "T064-13-{{run}}" },
    { "action": "assertRowCell", "level": "persistence", "name": "备注已更新", "matchColumn": "acctg_perid_table_no", "matchValue": "T064-13-{{run}}", "column": "rmk", "expected": "已编辑065-{{run}}", "mode": "contains" },
    { "action": "clearFilter" },

    { "action": "log", "name": "阶段5：删除会计期间信息" },
    { "action": "filter", "field": "会计期间表编号", "value": "T064-13-{{run}}" },
    { "action": "deleteRow", "column": "acctg_perid_table_no", "value": "T064-13-{{run}}" },
    { "action": "confirmDialog" },
    { "action": "assertToast", "level": "business", "name": "删除提示", "expected": "操作成功" },
    { "action": "assertGridRows", "level": "business", "name": "删除后筛选结果为0", "expected": 0 },
    { "action": "screenshot", "name": "TP-065-deleted" },
    { "action": "clearFilter" },
    { "action": "assertRow", "level": "persistence", "name": "删除后记录不存在", "column": "acctg_perid_table_no", "value": "T064-13-{{run}}", "expect": false },

    { "action": "log", "name": "阶段6：清理会计期间表" },
    { "action": "switchWorkItem", "workItem": "会计期间表" },
    { "action": "filter", "field": "会计期间表编号", "value": "T064-13-{{run}}" },
    { "action": "deleteRow", "column": "acctg_perid_table_no", "value": "T064-13-{{run}}" },
    { "action": "confirmDialog" },
    { "action": "assertToast", "level": "business", "name": "清理删除提示", "expected": "操作成功" },
    { "action": "assertGridRows", "level": "business", "name": "清理后筛选结果为0", "expected": 0 },
    { "action": "screenshot", "name": "TP-065-cleanup" },
    { "action": "clearFilter" },
    { "action": "assertRow", "level": "persistence", "name": "测试表已清理", "column": "acctg_perid_table_no", "value": "T064-13-{{run}}", "expect": false }
  ],
  "cleanup": [
    { "action": "clearFilter" },
    { "action": "switchWorkItem", "workItem": "会计期间信息" },
    { "action": "deleteRowIfPresent", "column": "acctg_perid_table_no", "value": "T064-13-{{run}}" },
    { "action": "switchWorkItem", "workItem": "会计期间表" },
    { "action": "deleteRowIfPresent", "column": "acctg_perid_table_no", "value": "T064-13-{{run}}" }
  ]
}
