{
  "id": "TP-064-WRITE",
  "name": "会计期间表：新增、筛选、编辑、13期、删除、14期限值（写入）",
  "workItem": "会计期间表",
  "steps": [
    { "action": "log", "name": "阶段1：新增 12 期" },
    { "action": "new" },
    { "action": "fill", "fieldPath": "acctg_perid_table.acctg_perid_table_no", "value": "T064-12-{{run}}" },
    { "action": "fill", "fieldPath": "acctg_perid_table.acctg_perid_table_name", "value": "自动化12期-{{run}}" },
    { "action": "fill", "fieldPath": "acctg_perid_table.insta_count", "value": "12" },
    { "action": "assertGridRows", "level": "ui", "name": "12期明细行数", "expected": 12 },
    { "action": "assertGridSwitch", "level": "business", "name": "12期无调整期", "rowIndex": 11, "expected": false },
    { "action": "assertSaveEnabled", "level": "ui", "name": "必填齐全后保存可用", "expected": true },
    { "action": "save" },
    { "action": "assertToast", "level": "business", "name": "保存提示", "expected": "操作成功" },
    { "action": "screenshot", "name": "TP-064-12-saved" },
    { "action": "closeDetail" },
    { "action": "waitRows", "min": 1 },
    { "action": "filter", "field": "会计期间表编号", "value": "T064-12-{{run}}" },
    { "action": "assertGridRows", "level": "business", "name": "筛选命中1条", "expected": 1 },
    { "action": "assertRow", "level": "persistence", "name": "列表存在新增记录", "column": "acctg_perid_table_no", "value": "T064-12-{{run}}", "expect": true },
    { "action": "assertRowCell", "level": "business", "name": "分期数回读", "matchColumn": "acctg_perid_table_no", "matchValue": "T064-12-{{run}}", "column": "insta_count", "expected": "12" },
    { "action": "screenshot", "name": "TP-064-12-filtered" },
    { "action": "clearFilter" },
    { "action": "assertRow", "level": "persistence", "name": "清空筛选后记录仍在", "column": "acctg_perid_table_no", "value": "T064-12-{{run}}", "expect": true },

    { "action": "log", "name": "阶段2：编辑 12 期" },
    { "action": "filter", "field": "会计期间表编号", "value": "T064-12-{{run}}" },
    { "action": "rowAction", "column": "acctg_perid_table_no", "value": "T064-12-{{run}}", "text": "编辑" },
    { "action": "assertFieldValue", "level": "business", "name": "编辑态编号回读", "fieldPath": "acctg_perid_table.acctg_perid_table_no", "expected": "T064-12-{{run}}" },
    { "action": "fill", "fieldPath": "acctg_perid_table.rmk", "value": "已编辑-{{run}}" },
    { "action": "save" },
    { "action": "assertToast", "level": "business", "name": "编辑保存提示", "expected": "操作成功" },
    { "action": "screenshot", "name": "TP-064-edited" },
    { "action": "closeDetail" },
    { "action": "filter", "field": "会计期间表编号", "value": "T064-12-{{run}}" },
    { "action": "assertRowCell", "level": "persistence", "name": "备注已更新", "matchColumn": "acctg_perid_table_no", "matchValue": "T064-12-{{run}}", "column": "rmk", "expected": "已编辑-{{run}}", "mode": "contains" },
    { "action": "clearFilter" },

    { "action": "log", "name": "阶段3：新增 13 期" },
    { "action": "new" },
    { "action": "fill", "fieldPath": "acctg_perid_table.acctg_perid_table_no", "value": "T064-13-{{run}}" },
    { "action": "fill", "fieldPath": "acctg_perid_table.acctg_perid_table_name", "value": "自动化13期-{{run}}" },
    { "action": "fill", "fieldPath": "acctg_perid_table.insta_count", "value": "13" },
    { "action": "assertGridRows", "level": "ui", "name": "13期明细行数", "expected": 13 },
    { "action": "assertGridSwitch", "level": "business", "name": "第13期为调整期", "rowIndex": 12, "expected": true },
    { "action": "assertGridSwitch", "level": "business", "name": "第12期非调整期", "rowIndex": 11, "expected": false },
    { "action": "assertGridCell", "level": "business", "name": "第13期期号", "rowIndex": 12, "colId": "acctg_perid_no", "expected": "13" },
    { "action": "save" },
    { "action": "assertToast", "level": "business", "name": "13期保存提示", "expected": "操作成功" },
    { "action": "screenshot", "name": "TP-064-13-saved" },
    { "action": "closeDetail" },
    { "action": "filter", "field": "会计期间表编号", "value": "T064-13-{{run}}" },
    { "action": "assertRowCell", "level": "persistence", "name": "13期分期数回读", "matchColumn": "acctg_perid_table_no", "matchValue": "T064-13-{{run}}", "column": "insta_count", "expected": "13" },
    { "action": "screenshot", "name": "TP-064-13-filtered" },
    { "action": "clearFilter" },

    { "action": "log", "name": "阶段4：删除 12 期" },
    { "action": "filter", "field": "会计期间表编号", "value": "T064-12-{{run}}" },
    { "action": "deleteRow", "column": "acctg_perid_table_no", "value": "T064-12-{{run}}" },
    { "action": "confirmDialog" },
    { "action": "assertToast", "level": "business", "name": "删除提示", "expected": "操作成功" },
    { "action": "assertGridRows", "level": "business", "name": "删除后筛选结果为0", "expected": 0 },
    { "action": "screenshot", "name": "TP-064-deleted" },
    { "action": "clearFilter" },
    { "action": "assertRow", "level": "persistence", "name": "删除后记录不存在", "column": "acctg_perid_table_no", "value": "T064-12-{{run}}", "expect": false },

    { "action": "log", "name": "阶段5：14 期限值探测" },
    { "action": "new" },
    { "action": "fill", "fieldPath": "acctg_perid_table.acctg_perid_table_no", "value": "T064-14-{{run}}" },
    { "action": "fill", "fieldPath": "acctg_perid_table.acctg_perid_table_name", "value": "14期探针-{{run}}" },
    { "action": "assertInputMax", "level": "ui", "name": "分期数控件上限", "fieldPath": "acctg_perid_table.insta_count", "expected": "13" },
    { "action": "fill", "fieldPath": "acctg_perid_table.insta_count", "value": "14" },
    { "action": "assertFieldValue", "level": "business", "name": "14期被控件拒绝并清空", "fieldPath": "acctg_perid_table.insta_count", "expected": "" },
    { "action": "log", "name": "14期不在交付范围，控件上限13符合当前口径" },
    { "action": "screenshot", "name": "TP-064-14-blocked" },
    { "action": "closeDetail" }
  ],
  "cleanup": [
    { "action": "clearFilter" },
    { "action": "deleteRowIfPresent", "column": "acctg_perid_table_no", "value": "T064-12-{{run}}" },
    { "action": "deleteRowIfPresent", "column": "acctg_perid_table_no", "value": "T064-13-{{run}}" },
    { "action": "deleteRowIfPresent", "column": "acctg_perid_table_no", "value": "T064-14-{{run}}" }
  ]
}
