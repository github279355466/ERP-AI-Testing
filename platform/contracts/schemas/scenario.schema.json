{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/contracts/scenario.schema.json",
  "title": "Athena Scenario",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "module_id",
    "title",
    "business_goal",
    "source_refs",
    "preconditions",
    "business_flow",
    "risk_level",
    "status",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "module_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "business_goal": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://athena.local/contracts/common.schema.json#/$defs/sourceRef" }
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "business_flow": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "risk_level": { "$ref": "https://athena.local/contracts/common.schema.json#/$defs/riskLevel" },
    "status": { "$ref": "https://athena.local/contracts/common.schema.json#/$defs/artifactStatus" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
