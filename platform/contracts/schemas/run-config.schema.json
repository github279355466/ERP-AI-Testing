{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/contracts/run-config.schema.json",
  "title": "Athena Run Config",
  "type": "object",
  "required": [
    "schema_version",
    "run_id_prefix",
    "mode",
    "authorization",
    "environment_ref",
    "user_ref",
    "module_packs",
    "integration_packs",
    "cleanup_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id_prefix": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["read_only", "controlled_write"] },
    "authorization": {
      "type": "object",
      "required": ["allow_write", "allow_high_risk_actions", "allowed_actions"],
      "additionalProperties": false,
      "properties": {
        "allow_write": { "type": "boolean" },
        "allow_high_risk_actions": { "type": "boolean" },
        "allowed_actions": {
          "type": "array",
          "items": {
            "enum": [
              "navigate",
              "search",
              "open_record",
              "select_master_data",
              "fill",
              "select_option",
              "upload",
              "save",
              "submit",
              "approve",
              "unapprove",
              "delete",
              "assert_visible",
              "assert_text",
              "assert_value",
              "assert_row",
              "capture_evidence"
            ]
          }
        }
      }
    },
    "environment_ref": { "type": "string", "minLength": 1 },
    "user_ref": { "type": "string", "minLength": 1 },
    "module_packs": {
      "type": "array",
      "items": { "$ref": "https://athena.local/contracts/common.schema.json#/$defs/moduleRef" }
    },
    "integration_packs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cleanup_policy": { "$ref": "https://athena.local/contracts/common.schema.json#/$defs/cleanupPolicy" }
  }
}
