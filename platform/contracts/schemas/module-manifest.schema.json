{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/contracts/module-manifest.schema.json",
  "title": "Athena Business Module Manifest",
  "type": "object",
  "required": ["schema_version", "module", "compatibility", "sources", "assets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "module": {
      "type": "object",
      "required": ["id", "name", "version", "status", "owner", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "https://athena.local/contracts/common.schema.json#/$defs/semver" },
        "status": { "$ref": "https://athena.local/contracts/common.schema.json#/$defs/artifactStatus" },
        "owner": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["platform_api"],
      "additionalProperties": false,
      "properties": {
        "platform_api": { "$ref": "https://athena.local/contracts/common.schema.json#/$defs/versionRange" }
      }
    },
    "sources": {
      "type": "object",
      "required": ["prd_index"],
      "additionalProperties": true,
      "properties": {
        "prd_index": { "type": "string", "minLength": 1 }
      }
    },
    "assets": {
      "type": "object",
      "required": ["knowledge", "page_mappings", "scenarios", "testcases", "data_recipes", "test_suites"],
      "additionalProperties": false,
      "properties": {
        "knowledge": { "type": "string", "minLength": 1 },
        "page_mappings": { "type": "string", "minLength": 1 },
        "scenarios": { "type": "string", "minLength": 1 },
        "testcases": { "type": "string", "minLength": 1 },
        "data_recipes": { "type": "string", "minLength": 1 },
        "test_suites": { "type": "string", "minLength": 1 }
      }
    }
  }
}
