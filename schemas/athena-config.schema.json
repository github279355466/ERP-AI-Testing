{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Athena ERP Runtime Config",
  "type": "object",
  "required": [
    "environment",
    "browser",
    "paths",
    "safety",
    "evidence",
    "knowledge"
  ],
  "additionalProperties": false,
  "properties": {
    "environment": {
      "type": "object",
      "required": [
        "name",
        "type",
        "baseUrl",
        "tenantId",
        "applicationCode",
        "lowcodeHost",
        "allowedOrigins"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "development",
            "test",
            "staging",
            "production"
          ]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "applicationCode": {
          "type": "string",
          "minLength": 1
        },
        "lowcodeHost": {
          "type": "string",
          "minLength": 1
        },
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lowcodeQuery": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "browser": {
      "type": "object",
      "required": [
        "mode",
        "engine",
        "cdpEndpoint",
        "proxy",
        "headless",
        "storageState",
        "userDataDir",
        "persistSession",
        "viewport",
        "navigationTimeoutMs",
        "readyTimeoutMs",
        "actionTimeoutMs",
        "retry",
        "trace"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "cdp",
            "playwright"
          ]
        },
        "engine": {
          "enum": [
            "chromium",
            "chrome",
            "edge"
          ]
        },
        "cdpEndpoint": {
          "type": "string",
          "format": "uri"
        },
        "proxy": {
          "type": "string"
        },
        "headless": {
          "type": "boolean"
        },
        "storageState": {
          "type": "string"
        },
        "userDataDir": {
          "type": "string"
        },
        "persistSession": {
          "type": "boolean"
        },
        "viewport": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "navigationTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "readyTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "actionTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "retry": {
          "type": "integer",
          "minimum": 1
        },
        "trace": {
          "type": "boolean"
        }
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "knowledge",
        "artifacts",
        "logs",
        "prd"
      ],
      "additionalProperties": false,
      "properties": {
        "knowledge": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "string",
          "minLength": 1
        },
        "logs": {
          "type": "string",
          "minLength": 1
        },
        "prd": {
          "type": "string"
        }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "readOnly",
        "allowWrite",
        "allowHighRiskActions",
        "allowDelete",
        "allowAudit",
        "allowUnAudit",
        "allowPosting",
        "allowStatusChange",
        "forbiddenActionTexts",
        "allowFixedCoordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "readOnly": {
          "type": "boolean"
        },
        "allowWrite": {
          "type": "boolean"
        },
        "allowHighRiskActions": {
          "type": "boolean"
        },
        "allowDelete": {
          "type": "boolean"
        },
        "allowAudit": {
          "type": "boolean"
        },
        "allowUnAudit": {
          "type": "boolean"
        },
        "allowPosting": {
          "type": "boolean"
        },
        "allowStatusChange": {
          "type": "boolean"
        },
        "forbiddenActionTexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowFixedCoordinates": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "captureScreenshotOnFailure",
        "captureTrace",
        "localOnly",
        "retentionDays",
        "redactSecrets"
      ],
      "additionalProperties": false,
      "properties": {
        "captureScreenshotOnFailure": {
          "type": "boolean"
        },
        "captureTrace": {
          "type": "boolean"
        },
        "localOnly": {
          "type": "boolean"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "redactSecrets": {
          "type": "boolean"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "required": [
        "expectedModelVersion",
        "frozenModelPath"
      ],
      "additionalProperties": false,
      "properties": {
        "expectedModelVersion": {
          "type": "string"
        },
        "frozenModelPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator": {
          "type": "string"
        },
        "testCaseId": {
          "type": "string"
        }
      }
    }
  }
}
